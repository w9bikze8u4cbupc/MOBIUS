{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobius.local/schema/scoring-endgame-v1.json",
  "title": "MOBIUS scoring and endgame contract",
  "type": "object",
  "required": ["contract", "projectId", "endGameModel", "scoringCategories", "tieBreakers", "victoryVisualBindings", "visualBindings", "sourceRefs", "confidence", "reviewState", "reviewRequired"],
  "properties": {
    "contract": { "const": "mobius-scoring-endgame-v1" },
    "projectId": { "type": ["string", "null"] },
    "gameIdentity": { "type": "object" },
    "endGameModel": { "$ref": "#/$defs/endGameModel" },
    "scoringCategories": { "type": "array", "items": { "$ref": "#/$defs/scoringCategory" } },
    "tieBreakers": { "type": "array", "items": { "$ref": "#/$defs/tieBreaker" } },
    "victoryVisualBindings": { "type": "array", "items": { "$ref": "#/$defs/victoryVisualBinding" } },
    "visualBindings": { "type": "array", "items": { "$ref": "#/$defs/visualBinding" } },
    "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reviewState": { "enum": ["accepted", "needs_review", "rejected"] },
    "reviewRequired": { "type": "boolean" }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "properties": {
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "section": { "type": ["integer", "null"], "minimum": 1 },
        "startOffset": { "type": ["integer", "null"], "minimum": 0 },
        "endOffset": { "type": ["integer", "null"], "minimum": 0 },
        "sourceImage": { "type": ["string", "null"] },
        "quote": { "type": ["string", "null"] },
        "uncertainty": { "type": ["string", "null"] }
      }
    },
    "victoryCondition": {
      "type": "object",
      "required": ["id", "label", "description", "sourceRefs", "confidence", "reviewState", "reviewRequired"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "spokenText": { "type": "string" },
        "componentRefs": { "type": "array", "items": { "type": "string" } },
        "visualAssetIds": { "type": "array", "items": { "type": "string" } },
        "visuals": { "type": "array", "items": { "type": "object" } },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewState": { "enum": ["accepted", "needs_review", "rejected"] },
        "reviewRequired": { "type": "boolean" }
      }
    },
    "endGameModel": {
      "type": "object",
      "required": ["trigger", "immediateVictoryConditions", "finishCurrentUnitRule", "finalPhase", "scoringRequired", "sourceRefs", "confidence", "reviewState", "reviewRequired"],
      "properties": {
        "trigger": { "type": "string", "minLength": 1 },
        "spokenText": { "type": "string" },
        "scoringOverviewText": { "type": "string" },
        "winnerText": { "type": "string" },
        "immediateVictoryConditions": { "type": "array", "items": { "$ref": "#/$defs/victoryCondition" } },
        "finishCurrentUnitRule": { "type": "string", "minLength": 1 },
        "finalPhase": { "type": "string", "minLength": 1 },
        "scoringRequired": { "type": "boolean" },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewState": { "enum": ["accepted", "needs_review", "rejected"] },
        "reviewRequired": { "type": "boolean" }
      }
    },
    "scoringCategory": {
      "type": "object",
      "required": ["id", "label", "description", "componentRefs", "visualAssetIds", "calculationType", "sourceRefs", "confidence", "reviewState", "reviewRequired"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "spokenText": { "type": "string" },
        "componentRefs": { "type": "array", "items": { "type": "string" } },
        "visualAssetIds": { "type": "array", "items": { "type": "string" } },
        "calculationType": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewState": { "enum": ["accepted", "needs_review", "rejected"] },
        "reviewRequired": { "type": "boolean" },
        "evidenceLevel": { "type": "string" }
      }
    },
    "tieBreaker": {
      "type": "object",
      "required": ["order", "rule", "sourceRefs", "confidence", "reviewState", "reviewRequired"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewState": { "enum": ["accepted", "needs_review", "rejected"] },
        "reviewRequired": { "type": "boolean" }
      }
    },
    "visualBinding": {
      "type": "object",
      "required": ["scoringCategoryId", "componentRefs", "visualAssetIds", "sourceRefs", "confidence", "reviewState", "reviewRequired", "provenance"],
      "properties": {
        "scoringCategoryId": { "type": "string", "minLength": 1 },
        "componentRefs": { "type": "array", "items": { "type": "string" } },
        "visualAssetIds": { "type": "array", "items": { "type": "string" } },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewState": { "enum": ["accepted", "needs_review", "rejected"] },
        "reviewRequired": { "type": "boolean" },
        "provenance": { "type": ["object", "null"] }
      }
    },
    "victoryVisualBinding": {
      "type": "object",
      "required": ["scoringCategoryId", "componentRefs", "visualAssetIds", "sourceRefs", "confidence", "reviewState", "reviewRequired", "provenance"],
      "properties": {
        "scoringCategoryId": { "type": "string", "minLength": 1 },
        "componentRefs": { "type": "array", "items": { "type": "string" } },
        "visualAssetIds": { "type": "array", "items": { "type": "string" } },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewState": { "enum": ["accepted", "needs_review", "rejected"] },
        "reviewRequired": { "type": "boolean" },
        "provenance": { "type": ["object", "null"] }
      }
    }
  }
}
