{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubric_version", "executive_summary", "overall_score_10", "category_scores", "findings", "three_highest_impact_next_changes", "strengths_to_preserve", "moments_that_feel_most_human", "moments_that_feel_most_ai_generated", "release_verdict"],
  "properties": {
    "rubric_version": {"type": "string"},
    "executive_summary": {"type": "string"},
    "overall_score_10": {"type": "number", "minimum": 0, "maximum": 10},
    "category_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand_and_intro", "audio_identity_and_continuity", "narration_warmth_and_naturalness", "thematic_engagement", "teaching_clarity", "visual_relevance_and_variety", "french_visual_coherence", "screen_space_utilization", "layout_and_legibility", "motion_and_transitions", "pacing_and_retention", "outro_and_call_to_action", "professional_finish"],
      "properties": {
        "brand_and_intro": {"type": "number", "minimum": 0, "maximum": 10},
        "audio_identity_and_continuity": {"type": "number", "minimum": 0, "maximum": 10},
        "narration_warmth_and_naturalness": {"type": "number", "minimum": 0, "maximum": 10},
        "thematic_engagement": {"type": "number", "minimum": 0, "maximum": 10},
        "teaching_clarity": {"type": "number", "minimum": 0, "maximum": 10},
        "visual_relevance_and_variety": {"type": "number", "minimum": 0, "maximum": 10},
        "french_visual_coherence": {"type": "number", "minimum": 0, "maximum": 10},
        "screen_space_utilization": {"type": "number", "minimum": 0, "maximum": 10},
        "layout_and_legibility": {"type": "number", "minimum": 0, "maximum": 10},
        "motion_and_transitions": {"type": "number", "minimum": 0, "maximum": 10},
        "pacing_and_retention": {"type": "number", "minimum": 0, "maximum": 10},
        "outro_and_call_to_action": {"type": "number", "minimum": 0, "maximum": 10},
        "professional_finish": {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "three_highest_impact_next_changes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "strengths_to_preserve": {"type": "array", "items": {"type": "string"}},
    "moments_that_feel_most_human": {"type": "array", "items": {"$ref": "#/$defs/human_moment"}},
    "moments_that_feel_most_ai_generated": {"type": "array", "items": {"$ref": "#/$defs/ai_moment"}},
    "release_verdict": {"type": "string", "enum": ["not_ready", "internal_review", "publishable_with_minor_fixes", "publishable"]}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "end_timestamp", "severity", "category", "what_viewer_sees_or_hears", "observable_evidence", "why_it_hurts_or_helps", "specific_fix", "confidence"],
      "properties": {
        "timestamp": {"type": "string", "pattern": "^[0-9]{2,}:([0-5][0-9]):([0-5][0-9])$|^[0-9]+:[0-5][0-9]$"},
        "end_timestamp": {"anyOf": [{"type": "string", "pattern": "^[0-9]{2,}:([0-5][0-9]):([0-5][0-9])$|^[0-9]+:[0-5][0-9]$"}, {"type": "null"}]},
        "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
        "category": {"type": "string"},
        "what_viewer_sees_or_hears": {"type": "string"},
        "observable_evidence": {"type": "string"},
        "why_it_hurts_or_helps": {"type": "string"},
        "specific_fix": {"type": "string"},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
      }
    },
    "human_moment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "reason"],
      "properties": {"timestamp": {"type": "string"}, "reason": {"type": "string"}}
    },
    "ai_moment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "reason", "specific_fix"],
      "properties": {"timestamp": {"type": "string"}, "reason": {"type": "string"}, "specific_fix": {"type": "string"}}
    }
  }
}
