/data/logs/last-invalid-script-package.json

# Local-only contextual evidence payloads (the descriptor manifest is also local project data)
/data/contextual-evidence-adoption-links.json
/data/*/contextual-evidence/source/
/data/*/contextual-evidence/pages/
/data/*/contextual-evidence/crop-cache/
/data/*/contextual-evidence/manifest.json

# Canonical local project source PDFs and descriptors
/data/*/source/
